#!/usr/bin/env sh

PLUGIN_DIR="$CONFIG_DIR/plugins"

# On a cold start, initialize from macOS itself. The native appearance observer
# handles subsequent switches without restarting this process.
user_id="${UID:-$(/usr/bin/id -u)}"
if [ -z "${THEME_MODE:-}" ]; then
  if [ "$(/usr/bin/defaults read -g AppleInterfaceStyle 2>/dev/null)" = "Dark" ]; then
    THEME_MODE=dark
  else
    THEME_MODE=light
  fi
  export THEME_MODE
fi

. "$CONFIG_DIR/colors.sh"
printf '%s\n' "$THEME_MODE" > "/tmp/sketchybar_theme_mode_$user_id"

# Native events keep pointer feedback off the shell/plugin update path.
NATIVE_MOTION_PORT=""
if /bin/sh "$CONFIG_DIR/helpers/start_native.sh"; then
  NATIVE_MOTION_PORT="com.denis.sketchybar.native_motion"
else
  printf 'Native motion startup failed with status %s\n' "$?" >&2
fi

TEXT_FONT="JetBrainsMono Nerd Font Propo"
ICON_FONT="JetBrainsMono Nerd Font Propo"
APP_FONT="Rice App Icons"

# Floating, translucent shell with native macOS typography.
sketchybar --bar \
  position=top \
  display=all \
  height=38 \
  margin=8 \
  y_offset=5 \
  corner_radius=14 \
  color="$BAR_COLOR" \
  border_color="$BAR_BORDER" \
  border_width=1 \
  blur_radius=16 \
  shadow=off \
  font_smoothing=on \
  padding_left=7 \
  padding_right=7

sketchybar --default \
  updates=when_shown \
  icon.font="$ICON_FONT:Semibold:13.0" \
  icon.color="$TEXT" \
  label.font="$TEXT_FONT:Semibold:12.0" \
  label.color="$TEXT" \
  background.color="$ITEM_BG" \
  background.border_color="$ITEM_BORDER" \
  background.border_width=1 \
  background.corner_radius=10 \
  background.height=28 \
  padding_left=3 \
  padding_right=3 \
  icon.padding_left=8 \
  icon.padding_right=5 \
  label.padding_left=0 \
  label.padding_right=9

# Restore stable slot labels before generating display-aware Space pills.
/bin/sh "$HOME/.config/yabai/scripts/sync_space_roles.sh"

# Left cluster: launcher, rich spaces, and the focused application.
sketchybar --add item apple left \
  --set apple \
    icon="" \
    icon.font="$ICON_FONT:Semibold:18.0" \
    icon.color="$MAUVE" \
    icon.width=32 \
    icon.align=center \
    icon.padding_left=8 \
    icon.padding_right=0 \
    label.drawing=off \
    width=38 \
    padding_left=3 \
    padding_right=3 \
    background.color="$ITEM_BG_STRONG" \
    script="$PLUGIN_DIR/interactive.sh" \
    click_script="$PLUGIN_DIR/control_center.sh"
sketchybar --subscribe apple mouse.entered mouse.exited mouse.clicked

# Keep the launcher visually separate from the connected Space pills.
sketchybar --add item apple_spacer left \
  --set apple_spacer \
    width=6 \
    padding_left=0 \
    padding_right=0 \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off

# The Apple button opens the native AppKit control center over Mach IPC.

# Stable-ID Space pills are committed together after native events are ready.

# Incremental updates plus startup/wake snapshots for already-open apps.
sketchybar --add event yabai_space_snapshot
sketchybar --add item space_observer left \
  --set space_observer \
    drawing=off \
    updates=on \
    update_freq=30 \
    script="$PLUGIN_DIR/space_windows.sh" \
  --subscribe space_observer space_windows_change yabai_space_snapshot system_woke display_change

sketchybar --add event yabai_stack_changed
sketchybar --add item stack_observer left \
  --set stack_observer \
    drawing=off \
    updates=on \
    update_freq=0 \
    script="$PLUGIN_DIR/stack_status.sh" \
  --subscribe stack_observer yabai_stack_changed system_woke

# Rebuild the palette and notify running Neovim instances whenever macOS
# changes appearance, including changes made outside our keyboard shortcut.
sketchybar --add event system_theme_changed AppleInterfaceThemeChangedNotification
sketchybar --add item theme_observer left \
  --set theme_observer \
    drawing=off \
    updates=on \
    script="$PLUGIN_DIR/theme_changed.sh" \
  --subscribe theme_observer system_theme_changed

# Clears any missed item-exit event when the pointer leaves the full bar.
sketchybar --add event native_palette_changed
sketchybar --add event native_hover_test
sketchybar --add event native_topology_begin
sketchybar --add event native_topology_end
sketchybar --add event native_space_plan
sketchybar --add item hover_observer left \
  --set hover_observer \
    drawing=off \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
  --subscribe hover_observer mouse.exited.global space_change native_palette_changed native_hover_test native_topology_begin native_topology_end native_space_plan

sketchybar --add item front_app left \
  --set front_app \
    icon=":finder:" \
    icon.font="$APP_FONT:Regular:16.0" \
    label="Desktop" \
    label.font="$TEXT_FONT:Semibold:13.0" \
    label.max_chars=26 \
    label.color="$SUBTEXT" \
    background.color="$ITEM_BG_STRONG" \
    script="$PLUGIN_DIR/interactive.sh" \
  --subscribe front_app front_app_switched mouse.entered mouse.exited

# The media island disappears completely when macOS has no active media.
sketchybar --add item media center \
  --set media \
    drawing=off \
    icon="󰎆" \
    icon.color="$MAUVE" \
    label="Nothing playing" \
    label.font="$TEXT_FONT:Semibold:11.0" \
    label.max_chars=42 \
    scroll_texts=on \
    background.color="$ITEM_BG_STRONG" \
    background.border_color="$MAUVE" \
    update_freq=3 \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
    click_script="$PLUGIN_DIR/media_click.sh" \
  --subscribe media mouse.entered mouse.exited

# Right cluster: lightweight live system telemetry.
sketchybar --add graph cpu right 64 \
  --set cpu \
    icon="󰍛" \
    icon.color="$GREEN" \
    label="--%" \
    label.font="$TEXT_FONT:Semibold:13.0" \
    graph.color="$GREEN" \
    graph.fill_color="$GREEN_FILL" \
    graph.line_width=1.5 \
    update_freq=4 \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
    click_script='open -a "Activity Monitor"' \
  --subscribe cpu mouse.entered mouse.exited

sketchybar --add item memory right \
  --set memory \
    icon="󰘚" \
    icon.color="$YELLOW" \
    label="--%" \
    label.font="$TEXT_FONT:Semibold:13.0" \
    update_freq=12 \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
    click_script='open -a "Activity Monitor"' \
  --subscribe memory mouse.entered mouse.exited

sketchybar --add item network right \
  --set network \
    icon="󰖩" \
    icon.color="$TEAL" \
    label="↓ --  ↑ --" \
    label.font="$ICON_FONT:Semibold:12.0" \
    update_freq=4 \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
  --subscribe network wifi_change system_woke mouse.entered mouse.exited

sketchybar --add item volume right \
  --set volume \
    icon="󰕾" \
    icon.color="$BLUE" \
    label="--%" \
    label.font="$TEXT_FONT:Semibold:13.0" \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
    click_script="$PLUGIN_DIR/volume_click.sh" \
  --subscribe volume volume_change system_woke mouse.entered mouse.exited

sketchybar --add item battery right \
  --set battery \
    icon.font="$ICON_FONT:Regular:15.0" \
    icon.color="$GREEN" \
    label.font="$TEXT_FONT:Semibold:13.0" \
    update_freq=45 \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
  --subscribe battery power_source_change system_woke mouse.entered mouse.exited

sketchybar --add item clock right \
  --set clock \
    icon="󰃭" \
    icon.color="$MAUVE" \
    label.font="$TEXT_FONT:Semibold:13.0" \
    background.color="$ITEM_BG_STRONG" \
    update_freq=10 \
    updates=on \
    script="$PLUGIN_DIR/interactive.sh" \
    click_script='open -a "Calendar"' \
  --subscribe clock mouse.entered mouse.exited

if [ -n "$NATIVE_MOTION_PORT" ]; then
  # Data updates are dispatched by the helper only when needed. Hover and
  # selected-Space feedback execute directly over Mach IPC with no forks.
  set -- --set '/space\.[0-9][0-9]*/' script="" mach_helper="$NATIVE_MOTION_PORT" \
    --set apple click_script=""
  for item in apple hover_observer front_app media cpu memory network volume battery clock; do
    set -- "$@" --set "$item" script="" mach_helper="$NATIVE_MOTION_PORT"
  done
  sketchybar "$@"
  sketchybar --set theme_observer script="" mach_helper="com.denis.sketchybar.native_theme"
fi

/bin/sh "$HOME/.config/yabai/scripts/sync_space_items.sh" --force
sketchybar --hotload true
sketchybar --update
/bin/sh "$PLUGIN_DIR/native_palette.sh"

# A quick, smooth entrance after a cold start or config reload.
sketchybar --bar y_offset=-38
sketchybar --animate sin 10 --bar y_offset=5
