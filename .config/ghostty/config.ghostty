# First-run fallback; the bar writes the optional override on appearance changes.
theme = dark:Nordfox,light:Xcode Light
config-file = ?theme-mode
window-theme = system

font-family = JetBrainsMono Nerd Font
font-size = 17

window-decoration = auto
macos-titlebar-style = hidden
macos-window-shadow = false

window-padding-x = 10
window-padding-y = 8

macos-option-as-alt = right

cursor-style = block
cursor-style-blink = false

background-opacity = 0.9
background-opacity-cells = false
