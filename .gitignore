# Only the shared dotfiles belong in this repository. Other ~/.config data stays
# private and untracked, including newly installed applications.
/*
!/.gitignore
!/Brewfile
!/LICENSE
!/README.md
!/docs/
!/setup.sh
!/tests/
!/screenshots/
!/borders/
!/ghostty/
!/nvim/
!/sketchybar/
!/skhd/
!/yabai/

.DS_Store

# Machine-local state
# Personal wallpapers, custom logos, and selections never belong in Git.
/rice/
yabai/space_roles.tsv
yabai/yabai.sudoers
yabai/native-fix/yabai
yabai/native-fix/*.sudoers
yabai/scripts/install_native_fix.sh
ghostty/theme-mode
sketchybar/helpers/native_motion
sketchybar/helpers/native_theme
sketchybar/helpers/RicePanel.app/
sketchybar/themes/selection.json
sketchybar/helpers/space_controller
__pycache__/
*.pyc
github-copilot/
nvim.backup-*/
nvim.log

# Editor and shell noise
*.swp
*.swo
*~
